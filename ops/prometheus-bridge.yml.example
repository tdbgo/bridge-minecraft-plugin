# Merge this job into the private Prometheus configuration.
scrape_configs:
  - job_name: bridge-minecraft
    scrape_interval: 15s
    scrape_timeout: 5s
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials_file: /etc/bridge/secrets/metrics.token
    static_configs:
      - targets:
          - 127.0.0.1:25585
